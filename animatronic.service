[Unit]
Description=Animatronic character controller
After=network.target sound.target local-fs.target
Wants=llama-server.service
After=llama-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/kermit/kermit_animatronic
ExecStart=/usr/bin/python3 /home/kermit/kermit_animatronic/start.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
